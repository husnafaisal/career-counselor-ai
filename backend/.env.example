# ===============================
# LLM PROVIDER (OpenAI only)
# ===============================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
ANTHROPIC_API_KEY=

# ===============================
# Application Settings
# ===============================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ===============================
# Vector Database (RAG)
# ===============================
VECTOR_DB_PATH=../rag/vector_store

# ===============================
# Session Management
# ===============================
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_SECRET
SESSION_EXPIRE_MINUTES=1440

# ===============================
# CORS (Frontend URLs)
# ===============================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===============================
# Bot Configuration (OpenAI)
# ===============================
BOT_MODEL=gpt-4.1-mini
MAX_CONVERSATION_LENGTH=50
PITCH_THRESHOLD_MESSAGES=6
TRUST_BUILDING_MESSAGES=3

# ===============================
# Institute Info
# ===============================
INSTITUTE_NAME=Your Institute Name
INSTITUTE_EMAIL=support@yourinstitute.com
INSTITUTE_PHONE=+91-1234567890

# ===============================
# Analytics
# ===============================
ANALYTICS_ENABLED=True
TRACK_CONVERSATIONS=True
